@page "/old"

<PageTitle>Monster Builder 4E</PageTitle>

<MudSplitPanel Class="mud-width-full mud-height-full">

    <FirstPanel>
        <MudStack Justify="Justify.FlexStart" AlignItems="AlignItems.Start" Class="mud-width-full mud-height-full">
            
            <h2>Stat Block</h2>

            <MudStack StretchItems="StretchItems.Start" Row="true">
                <MudText>@creature.Name</MudText>
                <MudText>Level @creature.Level @(creature.RoleModifier != RoleModifier.None ? Formatter.Enum(creature.RoleModifier.ToString()) : "") @Formatter.Enum(creature.Role.ToString())</MudText>
            </MudStack>
            <MudStack StretchItems="StretchItems.Start" Row="true">
                <MudText>
                    @creature.Size @Formatter.Enum(creature.Origin.ToString()) @Formatter.Enum(creature.Type.ToString()) 
                    @if (!string.IsNullOrEmpty(creature.CreatureKeywords)) {
                        <span>(@creature.CreatureKeywords)</span>
                    }
                </MudText>
                <MudText>XP @creature.XP</MudText>
            </MudStack>
            <MudText>
                <MudIcon Icon="@Icons.Material.Filled.FastForward" /> Standard Actions
            </MudText>
            <MudText>
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" /> Move Actions
            </MudText>
            <MudText>
                <MudIcon Icon="@Icons.Material.Filled.KeyboardArrowRight" /> Minor Actions
            </MudText>
            <MudText>
                <MudIcon Icon="@Icons.Material.Filled.ArrowRight" /> Free Actions
            </MudText>
            <MudStack Row="true">
                <MudText>
                    <strong>Str</strong> @($"{creature.Abilities.Strength.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Strength)})")
                </MudText>
                <MudText>
                    <strong>Dex</strong> @($"{creature.Abilities.Dexterity.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Dexterity)})")
                </MudText>
                <MudText>
                    <strong>Wis</strong> @($"{creature.Abilities.Wisdom.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Wisdom)})")
                </MudText>
            </MudStack>
            <MudStack Row="true">
                <MudText>
                    <strong>Con</strong> @($"{creature.Abilities.Constitution.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Constitution)})")
                </MudText>
                <MudText>
                    <strong>Int</strong> @($"{creature.Abilities.Intelligence.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Intelligence)})")
                </MudText>
                <MudText>
                    <strong>Cha</strong> @($"{creature.Abilities.Charisma.Score} ({@FormatModifier(creature.AbilityCheckModifiers.Charisma)})")
                </MudText>
            </MudStack>


            <div class="preview-panel">                
                <div class="stat-block">
                    <div class="stat-block-header">
                        <h3 class="creature-name">@creature.Name</h3>
                        <div class="creature-subtitle">
                            Level @creature.Level @(creature.RoleModifier != RoleModifier.None ? Formatter.Enum(creature.RoleModifier.ToString()) : "") @Formatter.Enum(creature.Role.ToString())
                            @if (creature.XP > 0)
                            {
                                <span>XP @creature.XP</span>
                            }
                        </div>
                        <div class="creature-type">
                            @creature.Size @Formatter.Enum(creature.Origin.ToString()) @Formatter.Enum(creature.Type.ToString()) @if (!string.IsNullOrEmpty(creature.CreatureKeywords)) {
                            <span>(@creature.CreatureKeywords)</span>
                        }
                    </div>
                </div>

                <div class="stat-block-body">
                    <div class="stat-line">
                        <strong>HP</strong> @creature.HitPoints; <strong>Bloodied</strong> @(creature.HitPoints / 2)
                    </div>
                    <div class="stat-line">
                        <strong>AC</strong> @creature.ArmorClass; <strong>Fortitude</strong> @creature.Fortitude, <strong>Reflex</strong> @creature.Reflex, <strong>Will</strong> @creature.Will
                    </div>
                    <div class="stat-line">
                        <strong>Speed</strong> @creature.Speed@(string.IsNullOrEmpty(creature.SpecialMovement) ? "" : ", " + creature.SpecialMovement)
                    </div>
                    @if (creature.Resistances.Any())
                    {
                        <div class="stat-line">
                            <strong>Resist</strong> @string.Join(", ", creature.Resistances)
                        </div>
                    }
                    @if (creature.Immunities.Any())
                    {
                        <div class="stat-line">
                            <strong>Immune</strong> @string.Join(", ", creature.Immunities)
                        </div>
                    }
                    @if (creature.Vulnerabilities.Any())
                    {
                        <div class="stat-line">
                            <strong>Vulnerable</strong> @string.Join(", ", creature.Vulnerabilities)
                        </div>
                    }
                    <div class="stat-line">
                        <strong>Initiative</strong> @FormatModifier(creature.Initiative)
                    </div>
                    @if (!string.IsNullOrEmpty(creature.Senses))
                    {
                        <div class="stat-line">@creature.Senses</div>
                    }

                    @if (creature.Traits.Any())
                    {
                        <div class="stat-block-section">
                            @foreach (var trait in creature.Traits)
                            {
                                <div class="trait">
                                    <strong>@trait.Name</strong> @trait.Effect
                                </div>
                            }
                        </div>
                    }

                    @if (creature.Powers.Any())
                    {
                        <div class="stat-block-section">
                            @foreach (var power in creature.Powers)
                            {
                                <div class="power">
                                    <div class="power-header">
                                        <span class="power-icon">@GetPowerIcon(power.PowerType)</span>
                                        <strong>@power.Name</strong>
                                        <span class="power-usage">(@power.PowerType)</span>
                                        <span class="power-action">• @power.ActionType</span>
                                    </div>
                                    @if (power.Keywords.Any())
                                    {
                                        <div class="power-keywords">@string.Join(", ", power.Keywords)</div>
                                    }
                                    @if (!string.IsNullOrEmpty(power.Range))
                                    {
                                        <div><strong>Range:</strong> @power.Range</div>
                                    }
                                    @if (!string.IsNullOrEmpty(power.TargetInfo))
                                    {
                                        <div><strong>Target:</strong> @power.TargetInfo</div>
                                    }
                                    @if (power.IsAttack && !string.IsNullOrEmpty(power.OnHit.BaseDamage))
                                    {
                                        <div><strong>Hit:</strong> @power.OnHit.BaseDamage</div>
                                    }
                                    @if (!string.IsNullOrEmpty(power.Effect))
                                    {
                                        <div><strong>Effect:</strong> @power.Effect</div>
                                    }
                                </div>
                            }
                        </div>
                    }

                    <div class="stat-block-abilities">
                        <div class="ability-scores">
                            <div class="ability">
                                <div class="ability-name">Str</div>
                                <div class="ability-value">@creature.Abilities.Strength.Score (@FormatModifier(creature.AbilityCheckModifiers.Strength))</div>
                            </div>
                            <div class="ability">
                                <div class="ability-name">Con</div>
                                <div class="ability-value">@creature.Abilities.Constitution.Score (@FormatModifier(creature.AbilityCheckModifiers.Constitution))</div>
                            </div>
                            <div class="ability">
                                <div class="ability-name">Dex</div>
                                <div class="ability-value">@creature.Abilities.Dexterity.Score (@FormatModifier(creature.AbilityCheckModifiers.Dexterity))</div>
                            </div>
                            <div class="ability">
                                <div class="ability-name">Int</div>
                                <div class="ability-value">@creature.Abilities.Intelligence.Score (@FormatModifier(creature.AbilityCheckModifiers.Intelligence))</div>
                            </div>
                            <div class="ability">
                                <div class="ability-name">Wis</div>
                                <div class="ability-value">@creature.Abilities.Wisdom.Score (@FormatModifier(creature.AbilityCheckModifiers.Wisdom))</div>
                            </div>
                            <div class="ability">
                                <div class="ability-name">Cha</div>
                                <div class="ability-value">@creature.Abilities.Charisma.Score (@FormatModifier(creature.AbilityCheckModifiers.Charisma))</div>
                            </div>
                        </div>
                    </div>

                    <div class="stat-line">
                        <strong>Alignment</strong> @Formatter.Enum(creature.Alignment.ToString())
                        @if (creature.Languages.Any())
                        {
                            <span><strong>Languages</strong> @string.Join(", ", creature.Languages)</span>
                        }
                    </div>
                    @if (creature.Skills.Any())
                    {
                        <div class="stat-line">
                            <strong>Skills</strong> @string.Join(", ", creature.Skills)
                        </div>
                    }
                    @if (creature.Equipment.Any())
                    {
                        <div class="stat-line">
                            <strong>Equipment</strong> @string.Join(", ", creature.Equipment)
                        </div>
                    }
                </div>
            </div>
        </div>

        </MudStack>
    </FirstPanel>

    <SecondPanel>
        <MudStack Justify="Justify.Center" AlignItems="AlignItems.Center" Class="mud-width-full mud-height-full">
            <div class="monster-builder-container">
                <div class="form-panel">
                    <button @onclick="LoadRandomMonster" class="btn btn-primary" style="margin-bottom: 1rem;">Load Random Monster</button>
                    <div class="form-section">
                        <h3>Basic Information</h3>
                        <div class="form-group">
                            <label>Name:</label>
                            <input type="text" @bind="creature.Name" class="form-control" />
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Level:</label>
                                <input type="number" @bind="creature.Level" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                            <div class="form-group">
                                <label>XP:</label>
                                <input type="number" value="@creature.XP" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Role:</label>
                                <select @bind="creature.Role" class="form-control" @bind:event="oninput" @onchange="RecalculateStats">
                                    @foreach (var role in Enum.GetValues<Role>())
                                    {
                                        <option value="@role">@role</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Role Modifier:</label>
                                <select @bind="creature.RoleModifier" class="form-control" @bind:event="oninput" @onchange="RecalculateStats">
                                    @foreach (var modifier in Enum.GetValues<RoleModifier>())
                                    {
                                        <option value="@modifier">@modifier</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Origin:</label>
                                <select @bind="creature.Origin" class="form-control">
                                    @foreach (var origin in Enum.GetValues<CreatureOrigin>())
                                    {
                                        <option value="@origin">@origin</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Type:</label>
                                <select @bind="creature.Type" class="form-control">
                                    @foreach (var type in Enum.GetValues<CreatureType>())
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Size:</label>
                                <select @bind="creature.Size" class="form-control">
                                    @foreach (var size in Enum.GetValues<CreatureSize>())
                                    {
                                        <option value="@size">@size</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Keywords:</label>
                                <input type="text" @bind="creature.CreatureKeywords" class="form-control" placeholder="e.g., aquatic, mount" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Ability Scores</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label>Strength:</label>
                                <input type="number" @bind="creature.Abilities.Strength.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                            <div class="form-group">
                                <label>Constitution:</label>
                                <input type="number" @bind="creature.Abilities.Constitution.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                            <div class="form-group">
                                <label>Dexterity:</label>
                                <input type="number" @bind="creature.Abilities.Dexterity.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Intelligence:</label>
                                <input type="number" @bind="creature.Abilities.Intelligence.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                            <div class="form-group">
                                <label>Wisdom:</label>
                                <input type="number" @bind="creature.Abilities.Wisdom.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                            <div class="form-group">
                                <label>Charisma:</label>
                                <input type="number" @bind="creature.Abilities.Charisma.Score" class="form-control" @bind:event="oninput" @onchange="RecalculateStats" />
                            </div>
                        </div>

                        <button @onclick="RecalculateStats" class="btn btn-primary">Calculate Stats</button>
                    </div>

                    <div class="form-section">
                        <h3>Combat Stats</h3>
                        <div class="form-row">
                            <div class="form-group">
                                <label>HP:</label>
                                <input type="number" value="@creature.HitPoints" class="form-control" readonly />
                            </div>
                            <div class="form-group">
                                <label>Initiative:</label>
                                <input type="number" @bind="creature.Initiative" class="form-control" />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>AC:</label>
                                <input type="number" value="@creature.ArmorClass" class="form-control" readonly />
                            </div>
                            <div class="form-group">
                                <label>Fortitude:</label>
                                <input type="number" value="@creature.Fortitude" class="form-control" readonly />
                            </div>
                            <div class="form-group">
                                <label>Reflex:</label>
                                <input type="number" value="@creature.Reflex" class="form-control" readonly />
                            </div>
                            <div class="form-group">
                                <label>Will:</label>
                                <input type="number" value="@creature.Will" class="form-control" readonly />
                            </div>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Speed:</label>
                                <input type="number" @bind="creature.Speed" class="form-control" />
                            </div>
                            <div class="form-group">
                                <label>Special Movement:</label>
                                <input type="text" @bind="creature.SpecialMovement" class="form-control" placeholder="e.g., fly 6, swim 8" />
                            </div>
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Additional Info</h3>
                        <div class="form-group">
                            <label>Senses:</label>
                            <input type="text" @bind="creature.Senses" class="form-control" placeholder="e.g., Perception +5; darkvision" />
                        </div>

                        <div class="form-group">
                            <label>Trained Skills:</label>
                            <select @bind="selectedSkill" class="form-control">
                                <option value="">-- Select a skill to add --</option>
                                @foreach (var skill in Enum.GetValues<Skill>())
                                {
                                    if (!creature.TrainedSkills.Contains(skill))
                                    {
                                        <option value="@skill">@skill</option>
                                    }
                                }
                            </select>
                            <button @onclick="AddSkill" class="btn btn-secondary btn-sm">Add Skill</button>
                            <div class="selected-skills">
                                @foreach (var skill in creature.TrainedSkills)
                                {
                                    <span class="skill-tag">
                                        @skill
                                        <button @onclick="() => RemoveSkill(skill)" class="btn-remove">×</button>
                                    </span>
                                }
                            </div>
                            <small class="form-text text-muted">Calculated Skills: @string.Join(", ", creature.Skills)</small>
                        </div>

                        <div class="form-row">
                            <div class="form-group">
                                <label>Alignment:</label>
                                <select @bind="creature.Alignment" class="form-control">
                                    @foreach (var alignment in Enum.GetValues<Alignment>())
                                    {
                                        <option value="@alignment">@Formatter.Enum(alignment.ToString())</option>
                                    }
                                </select>
                            </div>
                            <div class="form-group">
                                <label>Languages:</label>
                                <input type="text" @bind="languagesText" class="form-control" placeholder="e.g., Common, Draconic" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Resistances:</label>
                            <input type="text" @bind="resistancesText" class="form-control" placeholder="e.g., fire 10, cold 5" />
                        </div>

                        <div class="form-group">
                            <label>Immunities:</label>
                            <input type="text" @bind="immunitiesText" class="form-control" placeholder="e.g., poison, disease" />
                        </div>

                        <div class="form-group">
                            <label>Vulnerabilities:</label>
                            <input type="text" @bind="vulnerabilitiesText" class="form-control" placeholder="e.g., fire 5" />
                        </div>

                        <div class="form-group">
                            <label>Equipment:</label>
                            <input type="text" @bind="equipmentText" class="form-control" placeholder="e.g., longsword, chainmail" />
                        </div>
                    </div>

                    <div class="form-section">
                        <h3>Traits & Powers</h3>
                        <button @onclick="AddTrait" class="btn btn-secondary">Add Trait</button>
                        @foreach (var trait in creature.Traits)
                        {
                            <div class="trait-editor">
                                <input type="text" @bind="trait.Name" class="form-control" placeholder="Trait Name" />
                                <textarea @bind="trait.Effect" class="form-control" placeholder="Trait Effect"></textarea>
                                <button @onclick="() => RemoveTrait(trait)" class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        }

                        <button @onclick="AddPower" class="btn btn-secondary">Add Power</button>
                        @foreach (var power in creature.Powers)
                        {
                            <div class="power-editor">
                                <input type="text" @bind="power.Name" class="form-control" placeholder="Power Name" />
                                <div class="form-row">
                                    <div class="form-group">
                                        <label>Usage:</label>
                                        <select @bind="power.PowerType" class="form-control">
                                            @foreach (var powerType in Enum.GetValues<PowerType>())
                                            {
                                                <option value="@powerType">@powerType</option>
                                            }
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>Action Type:</label>
                                        <select @bind="power.ActionType" class="form-control">
                                            @foreach (var actionType in Enum.GetValues<ActionType>())
                                            {
                                                <option value="@actionType">@actionType</option>
                                            }
                                        </select>
                                    </div>
                                </div>
                                <input type="text" @bind="power.Keywords" class="form-control" placeholder="Keywords (e.g., Fire, Weapon)" />
                                <input type="text" @bind="power.Range" class="form-control" placeholder="Range (e.g., Melee 1, Ranged 10)" />
                                <input type="text" @bind="power.TargetInfo" class="form-control" placeholder="Target (e.g., One creature)" />
                                <textarea @bind="power.OnHit.BaseDamage" class="form-control" placeholder="Hit damage (e.g., 2d6 + 3)"></textarea>
                                <textarea @bind="power.OnHit.HitEffect" class="form-control" placeholder="Hit effect"></textarea>
                                <textarea @bind="power.Effect" class="form-control" placeholder="Effect"></textarea>
                                <button @onclick="() => RemovePower(power)" class="btn btn-danger btn-sm">Remove</button>
                            </div>
                        }
                    </div>
                </div>

                <div class="preview-panel">
                    <h2>Stat Block Preview</h2>
                    <div class="stat-block">
                        <div class="stat-block-header">
                            <h3 class="creature-name">@creature.Name</h3>
                            <div class="creature-subtitle">
                                Level @creature.Level @(creature.RoleModifier != RoleModifier.None ? Formatter.Enum(creature.RoleModifier.ToString()) : "") @Formatter.Enum(creature.Role.ToString())
                                @if (creature.XP > 0)
                                {
                                    <span>XP @creature.XP</span>
                                }
                            </div>
                            <div class="creature-type">
                                @creature.Size @Formatter.Enum(creature.Origin.ToString()) @Formatter.Enum(creature.Type.ToString()) @if (!string.IsNullOrEmpty(creature.CreatureKeywords)) {
                                <span>(@creature.CreatureKeywords)</span>
                            }
                        </div>
                    </div>

                    <div class="stat-block-body">
                        <div class="stat-line">
                            <strong>HP</strong> @creature.HitPoints; <strong>Bloodied</strong> @(creature.HitPoints / 2)
                        </div>
                        <div class="stat-line">
                            <strong>AC</strong> @creature.ArmorClass; <strong>Fortitude</strong> @creature.Fortitude, <strong>Reflex</strong> @creature.Reflex, <strong>Will</strong> @creature.Will
                        </div>
                        <div class="stat-line">
                            <strong>Speed</strong> @creature.Speed@(string.IsNullOrEmpty(creature.SpecialMovement) ? "" : ", " + creature.SpecialMovement)
                        </div>
                        @if (creature.Resistances.Any())
                        {
                            <div class="stat-line">
                                <strong>Resist</strong> @string.Join(", ", creature.Resistances)
                            </div>
                        }
                        @if (creature.Immunities.Any())
                        {
                            <div class="stat-line">
                                <strong>Immune</strong> @string.Join(", ", creature.Immunities)
                            </div>
                        }
                        @if (creature.Vulnerabilities.Any())
                        {
                            <div class="stat-line">
                                <strong>Vulnerable</strong> @string.Join(", ", creature.Vulnerabilities)
                            </div>
                        }
                        <div class="stat-line">
                            <strong>Initiative</strong> @FormatModifier(creature.Initiative)
                        </div>
                        @if (!string.IsNullOrEmpty(creature.Senses))
                        {
                            <div class="stat-line">@creature.Senses</div>
                        }

                        @if (creature.Traits.Any())
                        {
                            <div class="stat-block-section">
                                @foreach (var trait in creature.Traits)
                                {
                                    <div class="trait">
                                        <strong>@trait.Name</strong> @trait.Effect
                                    </div>
                                }
                            </div>
                        }

                        @if (creature.Powers.Any())
                        {
                            <div class="stat-block-section">
                                @foreach (var power in creature.Powers)
                                {
                                    <div class="power">
                                        <div class="power-header">
                                            <span class="power-icon">@GetPowerIcon(power.PowerType)</span>
                                            <strong>@power.Name</strong>
                                            <span class="power-usage">(@power.PowerType)</span>
                                            <span class="power-action">• @power.ActionType</span>
                                        </div>
                                        
                                        @if (!string.IsNullOrEmpty(power.Range))
                                        {
                                            <div><strong>Range:</strong> @power.Range</div>
                                        }
                                        @if (!string.IsNullOrEmpty(power.TargetInfo))
                                        {
                                            <div><strong>Target:</strong> @power.TargetInfo</div>
                                        }
                                        @if (power.IsAttack && !string.IsNullOrEmpty(power.OnHit.BaseDamage))
                                        {
                                            <div><strong>Hit:</strong> @power.OnHit.BaseDamage</div>
                                        }
                                        @if (!string.IsNullOrEmpty(power.Effect))
                                        {
                                            <div><strong>Effect:</strong> @power.Effect</div>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <div class="stat-block-abilities">
                            <div class="ability-scores">
                                <div class="ability">
                                    <div class="ability-name">Str</div>
                                    <div class="ability-value">@creature.Abilities.Strength.Score (@FormatModifier(creature.AbilityCheckModifiers.Strength))</div>
                                </div>
                                <div class="ability">
                                    <div class="ability-name">Con</div>
                                    <div class="ability-value">@creature.Abilities.Constitution.Score (@FormatModifier(creature.AbilityCheckModifiers.Constitution))</div>
                                </div>
                                <div class="ability">
                                    <div class="ability-name">Dex</div>
                                    <div class="ability-value">@creature.Abilities.Dexterity.Score (@FormatModifier(creature.AbilityCheckModifiers.Dexterity))</div>
                                </div>
                                <div class="ability">
                                    <div class="ability-name">Int</div>
                                    <div class="ability-value">@creature.Abilities.Intelligence.Score (@FormatModifier(creature.AbilityCheckModifiers.Intelligence))</div>
                                </div>
                                <div class="ability">
                                    <div class="ability-name">Wis</div>
                                    <div class="ability-value">@creature.Abilities.Wisdom.Score (@FormatModifier(creature.AbilityCheckModifiers.Wisdom))</div>
                                </div>
                                <div class="ability">
                                    <div class="ability-name">Cha</div>
                                    <div class="ability-value">@creature.Abilities.Charisma.Score (@FormatModifier(creature.AbilityCheckModifiers.Charisma))</div>
                                </div>
                            </div>
                        </div>

                        <div class="stat-line">
                            <strong>Alignment</strong> @Formatter.Enum(creature.Alignment.ToString())
                            @if (creature.Languages.Any())
                            {
                                <span><strong>Languages</strong> @string.Join(", ", creature.Languages)</span>
                            }
                        </div>
                        @if (creature.Skills.Any())
                        {
                            <div class="stat-line">
                                <strong>Skills</strong> @string.Join(", ", creature.Skills)
                            </div>
                        }
                        @if (creature.Equipment.Any())
                        {
                            <div class="stat-line">
                                <strong>Equipment</strong> @string.Join(", ", creature.Equipment)
                            </div>
                        }
                    </div>
                </div>
            </div>
            </div>
        </MudStack>
    </SecondPanel>

</MudSplitPanel>



@code {
    private Creature creature = new Creature();

    private Skill? selectedSkill = null;
    private string resistancesText = string.Empty;
    private string immunitiesText = string.Empty;
    private string vulnerabilitiesText = string.Empty;
    private string languagesText = string.Empty;
    private string equipmentText = string.Empty;

    protected override void OnInitialized()
    {
        // Start with empty form
    }

    private void LoadRandomMonster()
    {
        creature = PregenMonsters.GetRandomMonster();
        PopulateFormFields();
    }

    private void PopulateFormFields()
    {
        resistancesText = string.Join(", ", creature.Resistances);
        immunitiesText = string.Join(", ", creature.Immunities);
        vulnerabilitiesText = string.Join(", ", creature.Vulnerabilities);
        languagesText = string.Join(", ", creature.Languages);
        equipmentText = string.Join(", ", creature.Equipment);
    }

    private void RecalculateStats()
    {
        creature.Initiative = MonsterStats.CalculateInitiative(creature);

        ParseLists();
    }

    private void ParseLists()
    {
        creature.Languages = ParseCommaDelimitedList(languagesText);
        creature.Equipment = ParseCommaDelimitedList(equipmentText);
    }

    private List<string> ParseCommaDelimitedList(string text)
    {
        if (string.IsNullOrWhiteSpace(text))
            return new List<string>();

        return text.Split(',')
            .Select(s => s.Trim())
            .Where(s => !string.IsNullOrEmpty(s))
            .ToList();
    }

    private void AddSkill()
    {
        if (selectedSkill.HasValue && !creature.TrainedSkills.Contains(selectedSkill.Value))
        {
            creature.TrainedSkills.Add(selectedSkill.Value);
            selectedSkill = null;
        }
    }

    private void RemoveSkill(Skill skill)
    {
        creature.TrainedSkills.Remove(skill);
    }

    private void AddTrait()
    {
        creature.Traits.Add(new Trait());
    }

    private void RemoveTrait(Trait trait)
    {
        creature.Traits.Remove(trait);
    }

    private void AddPower()
    {
        creature.Powers.Add(new Power());
    }

    private void RemovePower(Power power)
    {
        creature.Powers.Remove(power);
    }

    private string FormatModifier(int value)
    {
        return value >= 0 ? $"+{value}" : value.ToString();
    }

    private string GetPowerIcon(PowerType powerType)
    {
        return powerType switch
        {
            PowerType.AtWill => "⚔",
            PowerType.Encounter => "⬢",
            PowerType.Daily => "◉",
            _ => "○"
        };
    }
}
