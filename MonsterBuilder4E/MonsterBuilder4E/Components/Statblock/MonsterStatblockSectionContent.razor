<MudCard Class="stat-block-card" Style="box-shadow: none; border-radius: 0px">
    <MudCardContent Style="@($"width: 100%; padding: 4px 6px; background-color: {BackgroundColor};")">
        <MudStack Spacing="1">
            @ChildContent
        </MudStack>        
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string BackgroundColor { get; set; } = "antiquewhite";
}
