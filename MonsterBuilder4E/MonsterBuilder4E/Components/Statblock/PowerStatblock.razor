
<MonsterStatblockEntryHeader _powerType="Power.PowerType">
    <MudText Typo="Typo.body1">
        <strong>@Power.Name</strong>
        @if(!string.IsNullOrWhiteSpace(Power.Keywords))
        {
            @($" ({Power.Keywords})")
        }
        ✦ <strong>@Formatter.Enum(Power.PowerType.ToString())</strong>
    </MudText>
</MonsterStatblockEntryHeader>
<MonsterStatblockEntryContent>
        @if (Power.ActionType == ActionType.ImmediateReaction || Power.ActionType == ActionType.ImmediateInterrupt)
        {
            <PowerPropertyTextblock Property="Trigger" Value="@Power.Trigger" />
        }
        @if (Power.IsAttack)
        {
            <PowerPropertyTextblock Property="Attack" Value="@MonsterStats.GetPowerAttackTextblock(Creature, Power)" />
            <PowerPropertyTextblock Property="Hit" Value="@MonsterStats.GetPowerHitTextblock(Creature, Power)" />
        }
        <PowerPropertyTextblock Property="Effect" Value="@Power.Effect" />
</MonsterStatblockEntryContent>

@code {
    [Parameter]
    public Creature Creature { get; set; } = new();
    
    [Parameter]
    public Power Power { get; set; } = new();

}
