<MudCollapse Expanded="_contentExpanded">
    <MudStack Spacing="4" Class="pa-2">

        <MudTextField @bind-Value="Trait.Name" Label="Trait Name" Variant="Variant.Text" Typo="Typo.body2" />

        <MudGrid>
            <MudItem xs="4">
                <MudCheckBox @bind-Value="Trait.IsAura" Label="Is aura?" LabelPlacement="Placement.Start" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField @bind-Value="Trait.AuraRange" Label="Aura Range" Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="20" />
            </MudItem>
        </MudGrid>

        <MudTextField @bind-Value="Trait.Effect" Label="Effect" Variant="Variant.Text" Typo="Typo.body2" Lines="2" />

        <MudButton OnClick="() => Remove()" Color="Color.Error" Size="Size.Small">Remove</MudButton>

    </MudStack>
</MudCollapse>

@code {
    [Parameter]
    public CreatureTrait Trait { get; set; } = new();

    [Parameter]
    public EventCallback<CreatureTrait> RemoveTraitCallback { get; set; }

    bool _contentExpanded = true;

    private void ExpandCollapseContent()
    {
        _contentExpanded = !_contentExpanded;
    }

    private async Task Remove()
    {
        await RemoveTraitCallback.InvokeAsync(Trait);
    }

    [Parameter]
    public EventCallback<CreatureTrait> TraitChanged { get; set; }

    async Task OnTraitUpdate(ChangeEventArgs e)
    {
        var trait = (CreatureTrait)e.Value!;
        await TraitChanged.InvokeAsync(trait);
    }

}
