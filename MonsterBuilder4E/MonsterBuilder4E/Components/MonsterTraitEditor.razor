
<MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End" @onclick="ExpandCollapseContent"
          Class="mt-2 px-2" Style="cursor: pointer; background-color: lightgreen">
    <MudText Typo="Typo.h6" Class="mt-1 mb-1">@(Trait.ExpandEditor ? $"Edit \"{Trait.Name}\"" : Trait.Name)</MudText>
    <MudIcon Icon="@(Trait.ExpandEditor? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
             Class="mt-1 mb-1" />
</MudStack>

<MudCollapse Expanded="Trait.ExpandEditor">
    <MudStack Spacing="4" Class="pa-2">

        <MudTextField @bind-Value="Trait.Name" @bind-Value:after="UpdateTrait" Label="Trait Name" Variant="Variant.Text" Typo="Typo.body2" />

        <MudGrid>
            <MudItem xs="4">
                <MudCheckBox @bind-Value="Trait.IsAura" @bind-Value:after="UpdateTrait" Label="Is aura?" LabelPlacement="Placement.Start" />
            </MudItem>
            <MudItem xs="4">
                <MudNumericField @bind-Value="Trait.AuraRange" @bind-Value:after="UpdateTrait" Label="Aura Range" Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="20" />
            </MudItem>
        </MudGrid>

        <MudTextField @bind-Value="Trait.Effect" @bind-Value:after="UpdateTrait" Label="Effect" Variant="Variant.Text" Typo="Typo.body2" Lines="2" />

        <MudButton OnClick="() => Remove()" Color="Color.Error" Size="Size.Small">Remove</MudButton>

    </MudStack>
</MudCollapse>

@code {
    [Parameter]
    public CreatureTrait Trait { get; set; } = new();

    private void ExpandCollapseContent()
    {
        Trait.ExpandEditor = !Trait.ExpandEditor;
    }

    //Update trait on parent component

    [Parameter]
    public EventCallback<CreatureTrait> TraitChanged { get; set; }

    async Task UpdateTrait()
    {        
        await TraitChanged.InvokeAsync(Trait);
    }

    //Remove trait

    [Parameter]
    public EventCallback<CreatureTrait> RemoveTraitCallback { get; set; }

    private async Task Remove()
    {
        await RemoveTraitCallback.InvokeAsync(Trait);
    }

}
