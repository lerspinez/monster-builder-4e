
<MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End" @onclick="ExpandCollapseContent"
    Class="px-2 py-1" Style="cursor: pointer; background-color: lightseagreen">
    <MudText Typo="Typo.h6">@SectionTitle</MudText>
    <MudIcon Icon="@(_contentExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" />
</MudStack>

<MudCollapse Expanded="_contentExpanded">
    @ChildContent
</MudCollapse>

@code {
    [Parameter]
    public string SectionTitle { get; set; } = string.Empty;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    bool _contentExpanded = true;

    private void ExpandCollapseContent()
    {
        _contentExpanded = !_contentExpanded;
    }
}
