
<MudStack Spacing="1" >
                    
    @* ---- Editor Header ---- *@
    <MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End">
        @* Monster Name *@
        <MudTextField @bind-Value="Creature.Name" @bind-Value:after="UpdateCreature" Label="Monster Name"
                      Variant="Variant.Outlined" Typo="Typo.h5" Margin="Margin.Dense" />
        @* Reset button *@
        <MudTooltip Text="Reset">
            <MudIcon Icon="@Icons.Material.Filled.ClearAll" Size="Size.Large" />
        </MudTooltip>
        @* Collapse All button *@
        <MudTooltip Text="Collapse All">
            <MudIcon Icon="@Icons.Material.Filled.UnfoldLess" Size="Size.Large" />
        </MudTooltip>
    </MudStack>

    @* ---- Section: Basic Information ---- *@
    <StatblockEditorSection SectionTitle="Basic Info">
        <BasicInfoEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>

    @* ---- Section: Ability Scores ---- *@
    <StatblockEditorSection SectionTitle="Ability Scores">
        <AbilityScoresEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>

    @* ---- Section: Tactical Stats ---- *@
    <StatblockEditorSection SectionTitle="Tactical Stats">
        <TacticalStatsEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>

    @* ---- Section: Other Stats ---- *@
    <StatblockEditorSection SectionTitle="Other Stats">
        <OtherStatsEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>
                                
    @* ---- Section: Monster Traits ---- *@
    <StatblockEditorSection SectionTitle="Traits">
        <TraitsEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>

    @* ---- Section: Monster Powers ---- *@
    <StatblockEditorSection SectionTitle="Powers">
        <PowersEditor @bind-Creature="Creature" UpdateCallback="UpdateCreature" />
    </StatblockEditorSection>

</MudStack>

@code {
    [Parameter]
    public Creature Creature { get; set; } = new();

    [Parameter]
    public EventCallback<Creature> CreatureChanged { get; set; }

    async Task UpdateCreature()
    {
        await CreatureChanged.InvokeAsync(Creature);
    }
}
