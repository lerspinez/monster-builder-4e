
<MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End" @onclick="ExpandCollapseContent"
          Class="mt-2 px-2" Style="cursor: pointer; background-color: lightgreen">
    <MudText Typo="Typo.h6" Class="mt-1 mb-1">@(Power.ExpandEditor ? $"Edit \"{Power.Name}\"" : _powerHeader)</MudText>
    <MudIcon Icon="@(Power.ExpandEditor? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
             Class="mt-1 mb-1" />
</MudStack>

<MudCollapse Expanded="Power.ExpandEditor">
    <MudStack Spacing="4" Class="pa-2">

        <MudTextField @bind-Value="Power.Name" @bind-Value:after="UpdatePower" Label="Power Name" Variant="Variant.Text" Typo="Typo.body2" />

        @* Power Keywords *@
        <MudTextField @bind-Value="Power.Keywords" @bind-Value:after="UpdatePower" Label="Keywords" Variant="Variant.Text" Typo="Typo.body2" 
            Placeholder="Weapon, fire, healing, etc" />
                        
        <MudGrid>
            @* Action Type *@
            <MudItem xs="6">
                <MudSelect @bind-Value="Power.ActionType" @bind-Value:after="UpdatePower" Label="Action" Variant="Variant.Text" Typo="Typo.body2">
                    @foreach (var actionType in Enum.GetValues<ActionType>())
                    {
                        <MudSelectItem Value="@actionType">@Formatter.Enum(actionType.ToString())</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @* Power Type *@
            <MudItem xs="6">
                <MudSelect @bind-Value="Power.PowerType" @bind-Value:after="UpdatePower" Label="Usage" Variant="Variant.Text" Typo="Typo.body2">
                    @foreach (var powerType in Enum.GetValues<PowerType>())
                    {
                        <MudSelectItem Value="@powerType">@Formatter.Enum(powerType.ToString())</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
                                        
        <MudGrid>
            @* Power Range *@
            <MudItem xs="6">
                <MudTextField @bind-Value="Power.Range" @bind-Value:after="UpdatePower" Label="Range" Variant="Variant.Text" Typo="Typo.body2" 
                    Placeholder="Melee 1, ranged 10/20, close blast 2, etc" />
            </MudItem>
            @* Target Info *@
            <MudItem xs="6">
                <MudTextField @bind-Value="Power.TargetInfo" @bind-Value:after="UpdatePower" Label="Target" Variant="Variant.Text" Typo="Typo.body2" 
                    Placeholder="One creature, all creatures in area, etc" />
            </MudItem>
        </MudGrid>

        <MudCheckBox @bind-Value="Power.IsAttack" @bind-Value:after="UpdatePower" Label="Is Attack" />

        @if (Power.IsAttack)
        {
            <MudGrid>
                @* Attack Ability *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.AttackAbility" @bind-Value:after="UpdatePower" Label="Attack Ability" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var ability in Enum.GetValues<Ability>())
                        {
                            <MudSelectItem Value="@ability">@Formatter.Enum(ability.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Attack Modifier *@
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Power.AttackModifier" @bind-Value:after="UpdatePower" Label="Attack Modifier" Variant="Variant.Text" Typo="Typo.body2" Min="-10" Max="10" />
                </MudItem>
                @* Target Defense *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.TargetDefense" @bind-Value:after="UpdatePower" Label="Target Defense" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var defense in Enum.GetValues<Defense>())
                        {
                            <MudSelectItem Value="@defense">@Formatter.Enum(defense.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
                                            
            <MudGrid>
                @* Base Damage *@
                <MudItem xs="4">
                    <MudTextField @bind-Value="Power.OnHit.BaseDamage" @bind-Value:after="UpdatePower" Label="Base Damage" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="1d8, 2d6, etc" />
                </MudItem>
                @* Damage Ability *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.OnHit.AbilityModifier" @bind-Value:after="UpdatePower" Label="Damage Ability" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var ability in Enum.GetValues<Ability>())
                        {
                            <MudSelectItem Value="@ability">@Formatter.Enum(ability.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Damage Modifier *@
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Power.OnHit.DamageModifier" @bind-Value:after="UpdatePower" Label="Damage Modifier" Variant="Variant.Text" Typo="Typo.body2" Min="-10" Max="50" />
                </MudItem>
            </MudGrid>
            
            <MudGrid>
                @* Damage Type *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.OnHit.DamageType" @bind-Value:after="UpdatePower" Label="Damage Type" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var damageType in Enum.GetValues<DamageType>())
                        {
                            <MudSelectItem Value="@damageType">@Formatter.Enum(damageType.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Critical Hit *@
                <MudItem xs="4">
                    <MudTextField @bind-Value="Power.OnHit.CriticalHit" @bind-Value:after="UpdatePower" Label="Critical Hit" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="+1d12 damage, etc" />
                </MudItem>
                @* On Miss *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.OnMiss" @bind-Value:after="UpdatePower" Label="On Miss" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var missEffect in Enum.GetValues<AttackMiss>())
                        {
                            <MudSelectItem Value="@missEffect">@Formatter.Enum(missEffect.ToString())</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
                                            
            <MudGrid>
                @* Hit Effect *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="Power.OnHit.HitEffect" @bind-Value:after="UpdatePower" Label="Hit Effect" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="ongoing 5 fire damage, etc" />
                </MudItem>
                @* Miss Effect *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="Power.MissEffect" @bind-Value:after="UpdatePower" Label="Miss Effect" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="the power is not expended, etc" />
                </MudItem>
            </MudGrid>
        }

        <MudTextField @bind-Value="Power.Effect" @bind-Value:after="UpdatePower" Label="Effect" Variant="Variant.Text" Typo="Typo.body2" Lines="2" />

        <MudButton OnClick="() => Remove()" Color="Color.Error" Size="Size.Small">Remove</MudButton>

    </MudStack>
</MudCollapse>

@code {
    [Parameter]
    public Power Power { get; set; } = new();

    public string _powerHeader => $"{Power.Name} ({Power.ActionType}, {Power.PowerType})";

    private void ExpandCollapseContent()
    {
        Power.ExpandEditor = !Power.ExpandEditor;
    }

    //Update power on parent component

    [Parameter]
    public EventCallback UpdateCallback { get; set; }

    [Parameter]
    public EventCallback<Power> PowerChanged { get; set; }

    async Task UpdatePower()
    {
        await PowerChanged.InvokeAsync(Power);
        await UpdateCallback.InvokeAsync();
    }

    //Remove power

    [Parameter]
    public EventCallback<Power> RemoveCallback { get; set; }

    private async Task Remove()
    {
        await RemoveCallback.InvokeAsync(Power);
    }

}