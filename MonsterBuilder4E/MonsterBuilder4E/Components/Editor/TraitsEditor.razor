
<MudStack Spacing="1" Class="pa-2">
    <MudStack Row Justify="Justify.FlexEnd" Spacing="4">
        <MudTooltip Text="Add Trait">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="mt-1 mb-1" @onclick="AddTrait" />
        </MudTooltip>
        <MudTooltip Text="Sort Traits">
            <MudIcon Icon="@Icons.Material.Filled.Sort" Class="mt-1 mb-1" @onclick="SortTraits" />
        </MudTooltip>
        <MudTooltip Text="Collapse All">
            <MudIcon Icon="@Icons.Material.Filled.UnfoldLess" Class="mt-1 mb-1" @onclick="CollapseAllTraits" />
        </MudTooltip>
    </MudStack>
                    
    <MudStack Spacing="1">
        @for (var i = 0; i < Creature.Traits.Count; i++)
        {
            var currentTrait = Creature.Traits[i];
            <TraitEditor @bind-Trait="currentTrait" UpdateCallback="UpdateCreature" RemoveCallback="RemoveTrait" />
        }
    </MudStack>
</MudStack>

@code {
    [Parameter]
    public Creature Creature { get; set; } = new();

    [Parameter]
    public EventCallback<Creature> CreatureChanged { get; set; }

    [Parameter]
    public EventCallback UpdateCallback { get; set; }

    async Task UpdateCreature()
    {
        await CreatureChanged.InvokeAsync(Creature);
        await UpdateCallback.InvokeAsync();
    }

    private void AddTrait()
    {
        Creature.Traits.Add(new Trait());
        UpdateCreature();
    }

    private void RemoveTrait(Trait trait)
    {
        Creature.Traits.Remove(trait);
        UpdateCreature();
    }

    private void SortTraits()
    {
        CollapseAllTraits();

        Creature.Traits = [.. Creature.Traits.OrderByDescending(t => t.IsAura).ThenBy(t => t.Name)];
        UpdateCreature();
    }

    private void CollapseAllTraits()
    {
        foreach (var trait in Creature.Traits)
        {
            trait.ExpandEditor = false;
        }
    }
}
