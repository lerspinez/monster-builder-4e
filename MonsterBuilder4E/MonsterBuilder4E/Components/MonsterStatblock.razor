<MudCard Class="stat-block-card" >
    <MudCardContent Style="max-width: 600px; margin-top: 20px; padding: 0px; background-color: antiquewhite">

        @* Header Section *@
        <MonsterStatblockHeader>
            <MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End">
                <MudText Typo="Typo.h6" Style="font-weight: bold; color: white;">Hobgoblin Soldier</MudText>
                <MudText Typo="Typo.body1" Style="font-weight: bold; color: white;">Level 4 Soldier</MudText>
            </MudStack>
            <MudStack Row StretchItems="StretchItems.Start">
                <MudText Typo="Typo.body1" Style="color: white;">Medium natural humanoid (goblinoid)</MudText>
                <MudText Typo="Typo.body1" Style="color: white;">XP 175</MudText>
            </MudStack>
        </MonsterStatblockHeader>

        @* Monster Vitals *@
        <MonsterStatblockSectionContent>
            @* Senses, Initiative *@
            <MudStack Row StretchItems="StretchItems.Start">
                <MudText Typo="Typo.body1">
                    <MudIcon Icon="@Icons.Material.Filled.RemoveRedEye" Size="Size.Small" Style="font-size: 0.8rem" />
                    <strong>Senses</strong> Perception +3; low-light vision
                </MudText>
                <MudText Typo="Typo.body1">
                    <MudIcon Icon="@Icons.Material.Filled.FlashOn" Size="Size.Small" Style="font-size: 0.8rem" />
                    <strong>Initiative</strong> +5
                </MudText>
            </MudStack>
            @* HP and Defenses *@
            <MudText Typo="Typo.body1"><strong>HP</strong> 56; <strong>Bloodied</strong> 28</MudText>
            <MudText Typo="Typo.body1"><strong>AC</strong> 20; <strong>Fortitude</strong> 17, <strong>Reflex</strong> 16, <strong>Will</strong> 15</MudText>
            <MudText Typo="Typo.body1"><strong>Speed</strong> 6</MudText>
        </MonsterStatblockSectionContent>
        

        @* Traits *@
        <MonsterStatblockSectionHeader>
            <MudText Typo="Typo.body1" Style="font-weight: bold; color: white;">Traits</MudText>
        </MonsterStatblockSectionHeader>

        @* Phalanx Soldier *@
        <MonsterStatblockEntryHeader>
            <MudText Typo="Typo.body1">
                <strong>Phalanx Soldier</strong> (aura 1)<br />
            </MudText>
        </MonsterStatblockEntryHeader>
        <MonsterStatblockEntryContent>
            <MudText Typo="Typo.body1">
                The hobgoblin gains a +2 bonus to AC while at least two hobgoblin allies are within the aura.
            </MudText>
        </MonsterStatblockEntryContent>

        @* Standard Actions *@        
        <MonsterStatblockSectionHeader>
            <MudText Typo="Typo.body1" Style="font-weight: bold; color: white;">Standard Actions</MudText>
        </MonsterStatblockSectionHeader>

        @* Longsword *@
        <MonsterStatblockEntryHeader>
            <MudText Typo="Typo.body1">
                <span style="font-size: 1.2em;">⚔</span> <strong>Longsword</strong> (weapon) ✦ <strong>At-Will</strong><br />
            </MudText>
        </MonsterStatblockEntryHeader>
        <MonsterStatblockEntryContent>
            <MudText Typo="Typo.body1">
                <strong>Attack:</strong> Melee 1 (one creature); +9 vs. AC<br />
                <strong>Hit:</strong> 1d8 + 5 damage, and the target is marked until the end of the hobgoblin's next turn.
            </MudText>
        </MonsterStatblockEntryContent>

        @* Crossbow Volley *@
        <MonsterStatblockEntryHeader>
            <MudText Typo="Typo.body1">
                <span style="font-size: 1.2em;">⬢</span> <strong>Crossbow Volley</strong> (weapon) ✦ <strong>Encounter</strong><br />
            </MudText>
        </MonsterStatblockEntryHeader>
        <MonsterStatblockEntryContent>
            <MudText Typo="Typo.body1">
                <strong>Attack:</strong> Ranged 15/30 (one creature); +9 vs. AC<br />
                <strong>Hit:</strong> 2d8 + 4 damage.
            </MudText>
        </MonsterStatblockEntryContent>

        @* Triggered Actions *@
        <MonsterStatblockSectionHeader>
            <MudText Typo="Typo.body1" Style="font-weight: bold; color: white;">Triggered Actions</MudText>
        </MonsterStatblockSectionHeader>

        @* Longsword *@
        <MonsterStatblockEntryHeader>
            <MudText Typo="Typo.body1">
                <span style="font-size: 1.2em;">⚔</span> <strong>Soldier's Retaliation</strong> ✦ <strong>At-Will</strong><br />
            </MudText>
        </MonsterStatblockEntryHeader>
        <MonsterStatblockEntryContent>
            <MudText Typo="Typo.body1">
                <em><strong>Trigger</strong></em>: An enemy marked by the hobgoblin makes an attack that doesn't include the hobgoblin as a target.<br />
                <strong>Effect</strong> (Immediate Interrupt): The hobgoblin uses longsword on the triggering enemy.
            </MudText>
        </MonsterStatblockEntryContent>

        <MudDivider Style="margin: 12px 0; border-color: black;" />

        @* Ability Scores *@
        <MudStack Row="true" Spacing="3" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body1"><strong>Str</strong> 18 (+6)</MudText>
            <MudText Typo="Typo.body1"><strong>Dex</strong> 14 (+4)</MudText>
            <MudText Typo="Typo.body1"><strong>Wis</strong> 12 (+3)</MudText>
        </MudStack>
        <MudStack Row="true" Spacing="3" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.body1"><strong>Con</strong> 16 (+5)</MudText>
            <MudText Typo="Typo.body1"><strong>Int</strong> 10 (+2)</MudText>
            <MudText Typo="Typo.body1"><strong>Cha</strong> 11 (+2)</MudText>
        </MudStack>

        <MudDivider Style="margin: 12px 0; border-color: black;" />

        @* Footer Section *@
        <MudStack Spacing="1">
            <MudText Typo="Typo.body1"><strong>Alignment</strong> Evil</MudText>
            <MudText Typo="Typo.body1"><strong>Languages</strong> Common, Goblin</MudText>
            <MudText Typo="Typo.body1"><strong>Skills</strong> Athletics +10, Intimidate +7</MudText>
            <MudText Typo="Typo.body1"><strong>Equipment</strong> longsword, chainmail, heavy shield, crossbow</MudText>
        </MudStack>
    </MudCardContent>
</MudCard>

@code {

}
