@using MonsterBuilder4E.Components.Statblock

<MudPaper Class="rounded-0 pa-2 overflow-y-scroll" Elevation="0" Style="max-height: 100%;">
    <MonsterStatblock Creature="Creature" />
</MudPaper>

@code {
    [Parameter]
    public Creature Creature { get; set; } = new();

    private string GetPowerIcon(PowerType powerType)
    {
        return powerType switch
        {
            PowerType.AtWill => "⚔",
            PowerType.Encounter => "⬢",
            PowerType.Daily => "◉",
            _ => "○"
        };
    }
}
