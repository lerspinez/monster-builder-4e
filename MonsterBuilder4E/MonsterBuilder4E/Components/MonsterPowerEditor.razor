
<MudStack Row StretchItems="StretchItems.Start" AlignItems="AlignItems.End" @onclick="ExpandCollapseContent"
          Class="mt-2 px-2" Style="cursor: pointer; background-color: lightgreen">
    <MudText Typo="Typo.h6" Class="mt-1 mb-1">@(_contentExpanded ? "Edit Power" : _powerHeader)</MudText>
    <MudIcon Icon="@(_contentExpanded? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
             Class="mt-1 mb-1" />
</MudStack>

<MudCollapse Expanded="_contentExpanded">
    <MudStack Spacing="4" Class="pa-2">

        <MudTextField @bind-Value="Power.Name" @bind-Value:after="UpdatePower" Label="Power Name" Variant="Variant.Text" Typo="Typo.body2" />

        @* Power Keywords *@
        <MudTextField @bind-Value="Power.Keywords" @bind-Value:after="UpdatePower" Label="Keywords" Variant="Variant.Text" Typo="Typo.body2" 
            Placeholder="Weapon, fire, healing, etc" />
                        
        <MudGrid>
            @* Action Type *@
            <MudItem xs="6">
                <MudSelect @bind-Value="Power.ActionType" @bind-Value:after="UpdatePower" Label="Action" Variant="Variant.Text" Typo="Typo.body2">
                    @foreach (var actionType in Enum.GetValues<ActionType>())
                    {
                        <MudSelectItem Value="@actionType">@actionType</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            @* Power Type *@
            <MudItem xs="6">
                <MudSelect @bind-Value="Power.PowerType" @bind-Value:after="UpdatePower" Label="Usage" Variant="Variant.Text" Typo="Typo.body2">
                    @foreach (var powerType in Enum.GetValues<PowerType>())
                    {
                        <MudSelectItem Value="@powerType">@powerType</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
                                        
        <MudGrid>
            @* Power Range *@
            <MudItem xs="6">
                <MudTextField @bind-Value="Power.Range" @bind-Value:after="UpdatePower" Label="Range" Variant="Variant.Text" Typo="Typo.body2" 
                    Placeholder="Melee 1, ranged 10/20, close blast 2, etc" />
            </MudItem>
            @* Target Info *@
            <MudItem xs="6">
                <MudTextField @bind-Value="Power.TargetInfo" @bind-Value:after="UpdatePower" Label="Target" Variant="Variant.Text" Typo="Typo.body2" 
                    Placeholder="One creature, all creatures in area, etc" />
            </MudItem>
        </MudGrid>

        <MudCheckBox @bind-Value="Power.IsAttack" @bind-Value:after="UpdatePower" Label="Is Attack" />

        @if (Power.IsAttack)
        {
            <MudGrid>
                @* Attack Ability *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.AttackAbility" @bind-Value:after="UpdatePower" Label="Attack Roll" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var ability in Enum.GetValues<Ability>())
                        {
                            <MudSelectItem Value="@ability">@ability</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Attack Modifier *@
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Power.AttackModifier" @bind-Value:after="UpdatePower" Label="Attack Bonus" Variant="Variant.Text" Typo="Typo.body2" Min="-10" Max="10" />
                </MudItem>
                @* Target Defense *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.Versus" @bind-Value:after="UpdatePower" Label="Target Defense" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var defense in Enum.GetValues<Defense>())
                        {
                            <MudSelectItem Value="@defense">@defense</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
                                            
            <MudGrid>
                @* Base Damage *@
                <MudItem xs="4">
                    <MudTextField @bind-Value="Power.Hit.BaseDamage" @bind-Value:after="UpdatePower" Label="Damage Roll" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="1d8, 2d6, etc" />
                </MudItem>
                @* Ability Modifier *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.Hit.AbilityModifier" @bind-Value:after="UpdatePower" Label="Ability Modifier" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var ability in Enum.GetValues<Ability>())
                        {
                            <MudSelectItem Value="@ability">@ability</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Damage Modifier *@
                <MudItem xs="4">
                    <MudNumericField @bind-Value="Power.Hit.DamageModifier" @bind-Value:after="UpdatePower" Label="Damage Bonus" Variant="Variant.Text" Typo="Typo.body2" Min="-10" Max="50" />
                </MudItem>
            </MudGrid>
                                            
            <MudGrid>
                @* Damage Type *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.Hit.DamageType" @bind-Value:after="UpdatePower" Label="Damage Type" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var damageType in Enum.GetValues<DamageType>())
                        {
                            <MudSelectItem Value="@damageType">@damageType</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                @* Critical Hit *@
                <MudItem xs="4">
                    <MudTextField @bind-Value="Power.Hit.CriticalHit" @bind-Value:after="UpdatePower" Label="Critical Hit" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="+1d12 damage, etc" />
                </MudItem>
                @* On Miss *@
                <MudItem xs="4">
                    <MudSelect @bind-Value="Power.Miss" @bind-Value:after="UpdatePower" Label="On Miss" Variant="Variant.Text" Typo="Typo.body2">
                        @foreach (var missEffect in Enum.GetValues<AttackMiss>())
                        {
                            <MudSelectItem Value="@missEffect">@missEffect</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
                                            
            <MudGrid>
                @* Hit Effect *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="Power.Hit.HitEffect" @bind-Value:after="UpdatePower" Label="Hit Effect" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="ongoing 5 fire damage, etc" />
                </MudItem>
                @* Miss Effect *@
                <MudItem xs="6">
                    <MudTextField @bind-Value="Power.MissEffect" @bind-Value:after="UpdatePower" Label="Miss Effect" Variant="Variant.Text" Typo="Typo.body2" 
                        Placeholder="the power is not expended, etc" />
                </MudItem>
            </MudGrid>
        }

        <MudTextField @bind-Value="Power.Effect" @bind-Value:after="UpdatePower" Label="Effect" Variant="Variant.Text" Typo="Typo.body2" Lines="2" />

        <MudButton OnClick="() => Remove()" Color="Color.Error" Size="Size.Small">Remove</MudButton>

    </MudStack>
</MudCollapse>

@code {
    [Parameter]
    public CreaturePower Power { get; set; } = new();

    [Parameter]
    public EventCallback<CreaturePower> RemovePowerCallback { get; set; }

    bool _contentExpanded = true;

    public string _powerHeader => $"{Power.Name} ({Power.ActionType}, {Power.PowerType})";

    private void ExpandCollapseContent()
    {
        _contentExpanded = !_contentExpanded;
    }

    private async Task Remove()
    {
        await RemovePowerCallback.InvokeAsync(Power);
    }

    [Parameter]
    public EventCallback<CreaturePower> PowerChanged { get; set; }

    async Task UpdatePower()
    {
        await PowerChanged.InvokeAsync(Power);
    }

}