<MudCard Class="stat-block-card" Style="box-shadow: none; border-radius: 0px">
    <MudCardContent Style="width: 100%; padding: 4px 18px; background-color: antiquewhite;">
        <MudStack Spacing="1">
            @ChildContent
        </MudStack>
    </MudCardContent>
</MudCard>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
