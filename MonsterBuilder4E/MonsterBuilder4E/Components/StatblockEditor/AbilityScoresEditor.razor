<MudGrid>
    @* Strength *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Strength.Score" @bind-Value:after="UpdateAbilities" Label="Strength" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
    @* Dexterity *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Dexterity.Score" @bind-Value:after="UpdateAbilities" Label="Dexterity" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
    @* Wisdom *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Wisdom.Score" @bind-Value:after="UpdateAbilities" Label="Wisdom" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
</MudGrid>

<MudGrid>
    @* Constitution *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Constitution.Score" @bind-Value:after="UpdateAbilities" Label="Constitution" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
    @* Intelligence *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Intelligence.Score" @bind-Value:after="UpdateAbilities" Label="Intelligence" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
    @* Charisma *@
    <MudItem xs="3">
        <MudNumericField @bind-Value="Abilities.Charisma.Score" @bind-Value:after="UpdateAbilities" Label="Charisma" 
            Variant="Variant.Text" Typo="Typo.body2" Min="1" Max="30" />
    </MudItem>
</MudGrid>

@code {
    [Parameter]
    public AbilityScores Abilities { get; set; } = new();

    [Parameter]
    public EventCallback<AbilityScores> AbilitiesChanged { get; set; }

    async Task UpdateAbilities()
    {
        await AbilitiesChanged.InvokeAsync(Abilities);
    }
}
